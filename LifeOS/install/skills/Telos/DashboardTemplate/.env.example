# Absolute path to the principal-supplied TELOS source.
TELOS_DIR=

# Read-only by default. Set true only after approving dashboard mutations.
TELOS_ALLOW_WRITES=false

# Optional HTTP adapter. Context is never sent unless both values are set.
TELOS_CHAT_ENDPOINT=
TELOS_CHAT_INCLUDE_CONTEXT=false
TELOS_CHAT_BEARER_TOKEN=
